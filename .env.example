# OpenClaw Railway Template - Environment Variables

# === Public Port ===
# Port on which the wrapper listens (external port exposed to the internet)
# If running on Railway, this should match the public port
# Default: 8080
OPENCLAW_PUBLIC_PORT=8080

# === State & Workspace ===
# Directory where OpenClaw stores configuration and state
# Default: ~/.openclaw
OPENCLAW_STATE_DIR=/root/.openclaw

# Directory where OpenClaw workspace files are stored
# Default: OPENCLAW_STATE_DIR/workspace
OPENCLAW_WORKSPACE_DIR=/root/.openclaw/workspace

# === Setup Authorization ===
# REQUIRED: Password to protect the /setup endpoint
# Used for Basic authentication when accessing http://localhost:8080/setup
# If not set, /setup will return 500 error
# IMPORTANT: Set this before deploying to Railway
SETUP_PASSWORD=your_secure_password_here

# === Gateway Configuration ===
# Admin token for OpenClaw gateway and Control UI authentication
# If not provided, a token will be auto-generated and persisted in STATE_DIR/gateway.token
# For persistence across restarts, either:
# 1. Leave empty and let it auto-generate once, OR
# 2. Set explicitly here (e.g., from Railway Variables)
OPENCLAW_GATEWAY_TOKEN=

# Internal port where the gateway listens (behind the wrapper proxy)
# This should be loopback-only, not exposed externally
# Default: 18789
INTERNAL_GATEWAY_PORT=18789

# Internal host where the gateway binds
# Should be 127.0.0.1 for security (loopback only)
# Default: 127.0.0.1
INTERNAL_GATEWAY_HOST=127.0.0.1

# === OpenClaw Entry Point ===
# Path to the OpenClaw entry.js file
# In Docker, this is /openclaw/dist/entry.js
# Default: /openclaw/dist/entry.js
OPENCLAW_ENTRY=/openclaw/dist/entry.js

# Node.js executable to use
# Default: node
OPENCLAW_NODE=node

# === Railway-Specific Variables ===
# These are automatically set by Railway deployment platform
# You don't need to set these manually
# RAILWAY_GIT_COMMIT_SHA=<auto-set>
# PORT=<may be set by Railway, but OPENCLAW_PUBLIC_PORT takes precedence>

# === Examples for Railway Deployment ===
# When deploying to Railway, set these as Railway Variables:
#
# SETUP_PASSWORD: my_secret_setup_password
# OPENCLAW_PUBLIC_PORT: 8080
#
# The gateway token and state/workspace directories are handled automatically.
